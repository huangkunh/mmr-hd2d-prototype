; Battle scene (HD-2D style)
; A wild enemy encounter. On load the BattleManager reads
; GameState.current_enemy_id, loads the enemy data via DataLoader and runs the
; turn-based loop. The BattleUI overlay (built in code) handles presentation.
;
; HD-2D notes:
;   * Background is a vertical GradientTexture2D (no external asset required).
;   * Sprites get an HDR modulate (>1.0) in battle_ui.gd so they bloom. For the
;     glow to actually show on 2D sprites, enable "HDR for 2D" under
;     Project Settings > Rendering > Viewport (the project already uses
;     Forward+, which supports it since Godot 4.2).
;   * A vignette + the WorldEnvironment glow below add the atmospheric look.
[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_manager.gd" id="1_battle_manager"]
[ext_resource type="Script" path="res://scripts/battle/battle_ui.gd" id="2_battle_ui"]

; Dark vertical gradient: lighter horizon at the top, fading to near-black.
[sub_resource type="Gradient" id="Gradient_bg"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(0.10, 0.08, 0.13, 1, 0.03, 0.02, 0.05, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_bg"]
gradient = SubResource("Gradient_bg")
width = 4
height = 256
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)

; Environment used for the HD-2D glow/bloom pass.
[sub_resource type="Environment" id="Environment_hd2d"]
glow_enabled = true
glow_intensity = 0.9
glow_strength = 1.1

; --- Root ---------------------------------------------------------------------
[node name="Battle" type="Node2D"]

; --- Background ---------------------------------------------------------------
[node name="Background" type="TextureRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture = SubResource("GradientTexture2D_bg")
expand_mode = 1
mouse_filter = 2

; --- Enemy display (center-top) ----------------------------------------------
[node name="EnemyDisplay" type="Node2D" parent="."]
position = Vector2(640, 230)

[node name="EnemySprite" type="Sprite2D" parent="EnemyDisplay"]

; --- Player display (center-bottom) ------------------------------------------
[node name="PlayerDisplay" type="Node2D" parent="."]
position = Vector2(640, 560)

[node name="PlayerSprite" type="Sprite2D" parent="PlayerDisplay"]

; --- HD-2D post-processing ---------------------------------------------------
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_hd2d")

; --- Battle UI overlay (command menu, HP bars, battle log, popups, end screens)
[node name="BattleUI" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2_battle_ui")

; --- Battle manager (drives the turn loop) -----------------------------------
[node name="BattleManager" type="Node" parent="."]
script = ExtResource("1_battle_manager")
battle_ui_path = NodePath("../BattleUI")
